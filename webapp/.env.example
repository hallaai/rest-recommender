# Copy to webapp/.env and fill in. Never commit .env.
# A Postgres instance with the pgvector and PostGIS extensions available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DB_SCHEMA=recsys
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Login for the UI/API. Empty password = no login (local dev only). Choose your own.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Models
MODEL_TEXT=gemini-3.1-flash-lite
MODEL_EMBED=gemini-embedding-001
EMBED_DIM=768

# Gemini spend caps, USD. A call that would cross a cap is refused before it runs.
BUDGET_TOTAL_USD=5
BUDGET_DAILY_USD=5

# Reference compute price for cost estimates (USD per vCPU-hour)
VCPU_HOUR_USD=0.04
# CPU-bound recommendation requests served at once (extra requests get 503 + Retry-After)
MAX_CONCURRENT=4

# Optional: override prices, USD per million tokens [input, output]
# PRICING_JSON={"gemini-3.1-flash-lite": [0.25, 1.5]}
